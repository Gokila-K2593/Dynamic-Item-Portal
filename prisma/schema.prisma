generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  items        Item[]
}

model Item {
  id        String    @id @default(cuid())
  name      String
  customId  String    @unique // ← THE MOST IMPORTANT LINE
  userId    String
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
  sections  Section[]
}

model Section {
  id           String         @id @default(cuid())
  heading      String
  displayOrder Int
  itemId       String
  item         Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fields       SectionField[]
}

model SectionField {
  id           String  @id @default(cuid())
  label        String
  value        String
  displayOrder Int
  sectionId    String
  section      Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}
